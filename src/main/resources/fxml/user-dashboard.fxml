
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.helpdesk.controller.UserDashboardController"
            prefWidth="1100"
            prefHeight="700"
            style="-fx-background-color: #f4f6fb;">

    <center>
        <VBox spacing="25"
              style="-fx-background-color: #f4f6fb;">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT">

                <VBox spacing="5">
                    <Label text="User Dashboard"
                           style="-fx-font-size: 26px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #172554;"/>

                    <Label fx:id="welcomeLabel"
                           text="Welcome!"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #64748b;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Logout"
                        onAction="#logout"
                        style="-fx-background-color: #dc2626;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-padding: 10 22 10 22;"/>

            </HBox>

            <!-- CREATE TICKET -->
            <VBox spacing="15"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Create Support Ticket"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #172554;"/>

                <Label text="Describe the problem you are facing:"
                       style="-fx-text-fill: #64748b;"/>

                <TextArea fx:id="problemField"
                          promptText="Enter your problem here..."
                          prefRowCount="3"
                          wrapText="true"/>

                <HBox alignment="CENTER_RIGHT">
                    <Button text="Submit Ticket"
                            onAction="#createTicket"
                            style="-fx-background-color: #2563eb;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 20 10 20;"/>
                </HBox>

            </VBox>

            <!-- MY TICKETS -->
            <VBox spacing="15"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <HBox alignment="CENTER_LEFT">

                    <Label text="My Tickets"
                           style="-fx-font-size: 18px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #172554;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Refresh"
                            onAction="#refreshTickets"
                            style="-fx-background-color: #e5e7eb;
                                   -fx-text-fill: #172554;"/>

                </HBox>

                <TableView fx:id="myTicketsTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="250">

                    <columns>

                        <TableColumn fx:id="ticketIdColumn"
                                     text="Ticket ID"
                                     prefWidth="120"/>

                        <TableColumn fx:id="problemColumn"
                                     text="Problem"
                                     prefWidth="400"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="180"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>
    