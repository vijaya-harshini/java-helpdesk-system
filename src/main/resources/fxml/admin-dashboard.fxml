
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.helpdesk.controller.AdminDashboardController"
            prefWidth="1100"
            prefHeight="700"
            style="-fx-background-color: #f4f6fb;">

    <center>
        <VBox spacing="25"
              style="-fx-background-color: #f4f6fb;">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT">

                <VBox spacing="5">
                    <Label text="Admin Dashboard"
                           style="-fx-font-size: 26px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #172554;"/>

                    <Label fx:id="welcomeLabel"
                           text="Welcome, Admin!"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #64748b;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Logout"
                        onAction="#logout"
                        style="-fx-background-color: #dc2626;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-padding: 10 22 10 22;"/>

            </HBox>

            <!-- STATISTICS -->
            <GridPane hgap="20" vgap="20">

                <VBox GridPane.columnIndex="0"
                      GridPane.rowIndex="0"
                      spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;">

                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="Total Tickets"/>

                    <Label fx:id="totalTicketsLabel"
                           text="0"
                           style="-fx-font-size: 30px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #172554;"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      GridPane.rowIndex="0"
                      spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;">

                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="Open Tickets"/>

                    <Label fx:id="openTicketsLabel"
                           text="0"
                           style="-fx-font-size: 30px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #2563eb;"/>
                </VBox>

                <VBox GridPane.columnIndex="0"
                      GridPane.rowIndex="1"
                      spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;">

                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="In Progress"/>

                    <Label fx:id="inProgressLabel"
                           text="0"
                           style="-fx-font-size: 30px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #d97706;"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      GridPane.rowIndex="1"
                      spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;">

                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="Resolved Tickets"/>

                    <Label fx:id="resolvedTicketsLabel"
                           text="0"
                           style="-fx-font-size: 30px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #16a34a;"/>
                </VBox>

            </GridPane>

            <!-- TICKET MANAGEMENT -->
            <VBox spacing="15"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Ticket Management"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #172554;"/>

                <TableView fx:id="recentTicketsTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="220">

                    <columns>

                        <TableColumn fx:id="ticketIdColumn"
                                     text="Ticket ID"
                                     prefWidth="120"/>

                        <TableColumn fx:id="problemColumn"
                                     text="Problem"
                                     prefWidth="350"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

                <!-- STATUS UPDATE -->
                <HBox spacing="15"
                      alignment="CENTER_LEFT">

                    <Label text="Update Status:"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #172554;"/>

                    <ComboBox fx:id="statusComboBox"
                              promptText="Select Status"
                              prefWidth="180"/>

                    <Button text="Update Status"
                            onAction="#updateTicketStatus"
                            style="-fx-background-color: #2563eb;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 20 10 20;"/>

                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>
